# Copy to .env and fill in. compose.yaml reads .env automatically.
# Every backend variable is prefixed EMS_ (see backend/app/core/config.py).

# --- Infrastructure
POSTGRES_USER=ems
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ems
STORAGE_ACCESS_KEY=ems
STORAGE_SECRET_KEY=change-me-storage

# --- Host ports (dev override)
EMS_HTTP_PORT=8080
EMS_POSTGRES_PORT=55432
EMS_REDIS_PORT=56379
EMS_MAILPIT_PORT=8025
EMS_STORAGE_CONSOLE_PORT=9001
EMS_UID=1000
EMS_GID=1000

# --- Application
EMS_ENVIRONMENT=dev
EMS_LOG_LEVEL=INFO
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMS_APP_ENCRYPTION_KEY=
EMS_PUBLIC_BASE_URL=http://localhost:8080
EMS_SESSION_COOKIE_SECURE=true
EMS_SESSION_IDLE_TIMEOUT_SECONDS=7200
EMS_SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

# --- Email (dev uses mailpit)
EMS_EMAIL_BACKEND=smtp
EMS_SMTP_HOST=mailpit
EMS_SMTP_PORT=1025
EMS_SMTP_USERNAME=
EMS_SMTP_PASSWORD=
EMS_SMTP_USE_TLS=false
EMS_EMAIL_FROM=EMS <no-reply@ems.local>

# --- Limits
EMS_IMPORT_MAX_BYTES=20971520
EMS_IMPORT_MAX_ROWS=100000
EMS_SCANNER_CACHE_TTL_SECONDS=43200
