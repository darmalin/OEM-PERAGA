# Campaign forms on their own host (EMS_CAMPAIGN_BASE_URL, FEATURES/12). Written to conf.d by
# 15-campaign-host.sh with __CAMPAIGN_HOST__ filled in. This host serves the form and its
# public API only: the desk, the admin API, and the scanner answer 404 here, so the address
# shared with the public reaches nothing else, and desk cookies never travel to it.
server {
    listen 80;
    server_name __CAMPAIGN_HOST__;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8000;
    client_max_body_size 64k;
    root /usr/share/nginx/html;

    # No token: the organiser's website.
    location = / {
        return 302 https://www.peragaexpo.com/;
    }

    location /api/v1/public/campaigns/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # The form build keeps its /r/ base, so its files load from /r/ on this host too.
    location /r/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    location = /r/theme.js {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # /{token}: tokens are 12 characters (campaigns.rules.TOKEN_RE).
    location ~ "^/[A-Za-z0-9_-]{12}/?$" {
        include /etc/nginx/campaign/form-headers.conf;
        try_files /r/index.html =404;
    }

    location / {
        return 404;
    }
}
